{
  "expo": {
    "name": "Atlantic Storm Watch",
    "slug": "eclipse-lookout",
    "owner": "rebecca0021",
    "version": "4.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0e1420",
    "splash": {
      "backgroundColor": "#0e1420"
    },
    "ios": {
      "bundleIdentifier": "com.eclipselookout.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.eclipselookout.app"
        ],
        "com.apple.developer.usernotifications.time-sensitive": true
      }
    },
    "android": {
      "package": "com.eclipselookout.app",
      "permissions": []
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-background-task",
      "@bacons/apple-targets"
    ],
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/fdbaffe8-c655-46ff-9262-6e1170a73c4b"
    },
    "extra": {
      "eas": {
        "projectId": "fdbaffe8-c655-46ff-9262-6e1170a73c4b"
      }
    },
    "scheme": "stormwatch"
  }
}
