{
  "expo": {
    "name": "UK Wildfire Watch",
    "slug": "eclipse-lookout",
    "owner": "rebecca0021",
    "version": "3.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#12161f",
    "splash": {
      "backgroundColor": "#12161f"
    },
    "ios": {
      "bundleIdentifier": "com.eclipselookout.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "UK Wildfire Watch uses your location to warn you when a wildfire is detected near you."
      }
    },
    "android": {
      "package": "com.eclipselookout.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-background-task",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "UK Wildfire Watch uses your location to warn you when a wildfire is detected near you."
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/fdbaffe8-c655-46ff-9262-6e1170a73c4b"
    },
    "extra": {
      "eas": {
        "projectId": "fdbaffe8-c655-46ff-9262-6e1170a73c4b"
      }
    }
  }
}
