{
  "expo": {
    "name": "Shift Pay",
    "slug": "shift-pay",
    "owner": "rebecca0021",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0e1116",
    "splash": {
      "backgroundColor": "#0e1116"
    },
    "ios": {
      "bundleIdentifier": "com.shiftpay.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.shiftpay.app",
      "permissions": []
    },
    "web": {
      "bundler": "metro"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "scheme": "shiftpay"
  }
}
